{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BotGroup.Chat",
  "version": "1.0.6",
  "identifier": "chat.botgroup.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "BotGroup.Chat",
        "width": 1024,
        "height": 768,
        "minWidth": 800,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' 'unsafe-inline' 'unsafe-eval' ipc: http://ipc.localhost tauri: http://tauri.localhost http://localhost:1420 ws://localhost:1421; img-src 'self' data: blob: asset: http://asset.localhost https://asset.localhost tauri: http: https:; connect-src 'self' ipc: http://ipc.localhost http://localhost:1420 ws://localhost:1421 http: https: ws: wss:;",
      "assetProtocol": {
        "enable": true,
        "scope": [
          "$APPDATA/**"
        ]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "dmg",
      "nsis",
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
